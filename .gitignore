
# FinBank - Git Ignore

# Environment / Secrets

.env
.env.*
!.env.example


# Node.js

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# Frontend / Vite

client/dist/
client/.vite/
client/node_modules/


# Backend

server/node_modules/
server/logs/
server/*.log


# Python / AI Service

ai-service/venv/
ai-service/.venv/
ai-service/__pycache__/
ai-service/**/__pycache__/
ai-service/*.pyc
ai-service/**/**/*.pyc

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/


# OS Files

.DS_Store
Thumbs.db
desktop.ini


# IDE / Editor

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/
*.iml


# Logs

*.log
logs/


# Temporary Files

*.tmp
*.temp
*.swp
*.swo


# Build / Coverage

coverage/
.nyc_output/
dist/
build/


# Database / Local Data

*.sqlite
*.sqlite3


# Secrets / Certificates

*.pem
*.key
*.crt


# Local uploads

uploads/
# Root Python virtual environment
/venv/
